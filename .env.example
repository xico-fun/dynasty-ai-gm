# ── Required ────────────────────────────────────────────────────────────────
# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# The Odds API (https://the-odds-api.com)
ODDS_API_KEY=your_odds_api_key_here

# Tavily Search API (https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# ── Optional ────────────────────────────────────────────────────────────────
# Sleeper single-user fallback. NOT needed in multi-user deployments — the
# active league + username come from the database per request (forwarded as
# headers). Only set these for local single-user / CLI use.
# SLEEPER_USERNAME=your_sleeper_username
# SLEEPER_LEAGUE_ID=your_sleeper_league_id

# Comma-separated allowed frontend origins for CORS (production).
# Defaults to http://localhost:3000 when unset.
# ALLOWED_ORIGINS=https://your-app.vercel.app

# LangSmith tracing (optional — for tracing/debugging LangGraph runs)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=dynasty-ai-gm

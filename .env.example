# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Sleeper (no API key needed — just configure your info)
SLEEPER_USERNAME=your_sleeper_username
SLEEPER_LEAGUE_ID=your_sleeper_league_id

# The Odds API (https://the-odds-api.com)
ODDS_API_KEY=your_odds_api_key_here

# Tavily Search API (https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# LangSmith (optional — for tracing/debugging LangGraph runs)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=dynasty-ai-gm
